{% macro card(id, date, type, image, video, poster, captionHtml, url, permalink) %}
<article class="post" data-post-id="{{ id }}" data-post-date="{{ date }}">
  {% if permalink %}
  <div class="post-header-row">
    <a class="archive-footer-link" href="/">access memory-a</a>
    <div class="age-signal" data-post-date="{{ date }}">0000</div>
  </div>
  {% else %}
  <div class="age-signal" data-post-date="{{ date }}">0000</div>
  {% endif %}

  <div class="primary">
    {% if type == "video" %}
      {% set posterDims = poster | imageDimensions %}
      <video muted playsinline preload="none" poster="{{ poster }}" width="{{ posterDims.width }}" height="{{ posterDims.height }}">
        <source src="{{ video }}" type="video/mp4">
      </video>
    {% else %}
      {% optimizedImage image, "" %}
    {% endif %}
  </div>

  {% if captionHtml %}
  <div class="caption">{{ captionHtml | safe }}</div>
  {% endif %}
</article>
{% endmacro %}
