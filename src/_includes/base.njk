<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>memory-a</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@200;300&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

{{ content | safe }}

<!-- MASTER VOID TRIGGER -->
<button class="ctrl-void void-trigger">void</button>

<!-- VOID OVERLAY -->
<div class="void-overlay" id="voidOverlay"></div>

<script src="/js/site.js"></script>

<!-- Catches invite/recovery links from Netlify Identity emails (which land
     on the homepage) and opens the set-password widget, then sends you on
     to the posting form. -->
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
if (window.netlifyIdentity) {
  window.netlifyIdentity.on("init", function(user) {
    if (!user) {
      window.netlifyIdentity.on("login", function() {
        document.location.href = "/admin/";
      });
    }
  });
}
</script>
</body>
</html>
